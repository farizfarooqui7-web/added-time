# ==========================================
# Top Bins - Production Environment Variables
# ==========================================

# PartyKit Edge WebSocket Host (Recommended)
# Deployed using `npm run party:deploy`:
VITE_PARTYKIT_HOST=top-bins.your-username.partykit.dev

# Legacy / Standalone WebSocket URL (Alternative Railway / Render server)
# VITE_WS_URL=wss://your-backend.up.railway.app

# Backend Port (For local monolithic server or Railway / Render process.env.PORT)
PORT=3001
