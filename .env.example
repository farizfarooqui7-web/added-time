# ==========================================
# Top Bins - Production Environment Variables
# ==========================================

# Frontend WebSocket endpoint (Vercel / Cloudflare Pages)
# Point this to your deployed WebSocket backend (e.g., Railway, Render, Fly.io, or VPS):
VITE_WS_URL=wss://your-backend.up.railway.app

# Backend Port (Server defaults to process.env.PORT || 8000 on host 0.0.0.0)
PORT=8000
