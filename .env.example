# ==========================================
# Top Bins - Production Environment Variables
# ==========================================

# Frontend WebSocket endpoint (Vercel / Cloudflare Pages)
# In production, point this to your deployed WebSocket backend (e.g., Railway or Render):
VITE_WS_URL=wss://your-backend.up.railway.app

# Backend Port (Render / Railway / Fly.io provide this automatically via process.env.PORT)
PORT=3001
