{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "top-bins-server",
  "main": "party/main.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "Main",
        "class_name": "TopBinsServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TopBinsServer"]
    }
  ]
}
